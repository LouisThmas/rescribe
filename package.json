{
  "name": "interview-rescribe",
  "version": "0.1.0",
  "description": "All-in-one interview transcription and Mom Test report CLI",
  "license": "MIT",
  "type": "module",
  "bin": {
    "interview-rescribe": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "transcription",
    "interview",
    "whisper",
    "qwen3-asr",
    "mom-test",
    "cli"
  ],
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "commander": "^15.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
